# Copy this file to pi/.env on the Raspberry Pi and fill in your values

# Address of the computer running the Flask app (run.py)
SERVER_URL=http://192.168.1.20:5000

# Hive this Pi belongs to, and its API key (must match DEFAULT_HIVE_API_KEY on the server)
HIVE_ID=1
API_KEY=dev-hive-1-key

# simulated | dht22 | bme280 | custom (custom = your own code in read_custom())
SENSOR_DRIVER=simulated
INTERVAL_SECONDS=30

# DHT22 data pin (board pin name) / BME280 I2C address
DHT_PIN=D4
BME280_ADDRESS=0x76

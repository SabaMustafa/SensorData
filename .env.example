# Copy this file to .env and change the values. .env is never committed to git.

SECRET_KEY=change-me-to-a-long-random-string

# Key the Raspberry Pi must send (X-API-Key header). Use a long random value,
# and put the same value in pi/.env on the Pi as API_KEY.
# Note: it is only used when the hive is first created (empty database).
DEFAULT_HIVE_API_KEY=dev-hive-1-key
DEFAULT_HIVE_NAME=Hive 1
DEFAULT_HIVE_LOCATION=Garden

# Live camera. Leave empty to show the demo video.
#   Pi stream:        CAMERA_URL=http://192.168.1.50:8000/stream.mjpg
#   PC webcam:        CAMERA_URL=0
CAMERA_URL=
CAMERA_FALLBACK_TO_DEMO=true
CAMERA_RETRY_SECONDS=30

# Queen detection
QUEEN_CONF=0.17
DETECT_EVERY_N_FRAMES=2

# Database (default: instance/beehive.db). PostgreSQL later, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost/beehive

# Hive shown as offline if no reading arrives within this many seconds
SENSOR_OFFLINE_AFTER_SECONDS=180

# Server
HOST=0.0.0.0
PORT=5000
